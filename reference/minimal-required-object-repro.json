{
  "openapi": "3.1.0",
  "info": {
    "title": "Repro: required object missing from example",
    "version": "1.0.0",
    "description": "Two identical endpoints with the same example. The ONLY difference: in endpoint B the `signers` object is listed in the root `required` array. The example does not contain `signers`. Select the `Individual` example on both and compare the request body."
  },
  "servers": [
    {
      "url": "https://example.com"
    }
  ],
  "paths": {
    "/a-signers-optional": {
      "post": {
        "operationId": "aSignersOptional",
        "summary": "A: signers NOT required",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/userA"
              },
              "examples": {
                "Individual": {
                  "value": {
                    "type": "NaturalPerson",
                    "email": "user@example.com"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/b-signers-required": {
      "post": {
        "operationId": "bSignersRequired",
        "summary": "B: signers required",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/userB"
              },
              "examples": {
                "Individual": {
                  "value": {
                    "type": "NaturalPerson",
                    "email": "user@example.com"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "person": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "object",
            "properties": {
              "first": {
                "type": "string"
              }
            }
          }
        }
      },
      "signers": {
        "type": "object",
        "required": [
          "signer1"
        ],
        "properties": {
          "signer1": {
            "$ref": "#/components/schemas/person"
          },
          "signer2": {
            "$ref": "#/components/schemas/person"
          }
        }
      },
      "userA": {
        "type": "object",
        "required": [
          "type",
          "email"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "NaturalPerson",
              "LLC"
            ]
          },
          "email": {
            "type": "string"
          },
          "signers": {
            "$ref": "#/components/schemas/signers"
          }
        }
      },
      "userB": {
        "type": "object",
        "required": [
          "type",
          "email",
          "signers"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "NaturalPerson",
              "LLC"
            ]
          },
          "email": {
            "type": "string"
          },
          "signers": {
            "$ref": "#/components/schemas/signers"
          }
        }
      }
    }
  }
}