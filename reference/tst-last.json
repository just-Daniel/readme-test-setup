{
  "openapi": "3.1.0",
  "info": {
    "title": "Test repo",
    "version": "1.0.0",
    "description": "`authorizedSigners` is required; inside it only `authorizedSigner1` is required. Open Create User (no example or the `Individual` example): the body also contains optional `authorizedSigner2-4` as `{ \"name\": {} }`."
  },
  "servers": [
    {
      "url": "https://example.com"
    }
  ],
  "x-readme": {
    "explorer-enabled": false,
    "proxy-enabled": true
  },
  "paths": {
    "/users": {
      "post": {
        "operationId": "createUser",
        "summary": "Create User (optional authorizedSigner2-4 injected)",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/userCreate"
              },
              "examples": {
                "Individual": {
                  "value": {
                    "referenceID": "1234UniqueRefID",
                    "type": "NaturalPerson",
                    "name": {
                      "individual": {
                        "first": "Samwise",
                        "middle": "Sam",
                        "last": "Gamgee"
                      }
                    },
                    "email": "user@example.com",
                    "phone": {
                      "countryCode": "1",
                      "number": "5555555555"
                    },
                    "address": {
                      "line1": "123 Street",
                      "city": "San Francisco",
                      "state": "CA",
                      "zipcode": "94103",
                      "country": "840"
                    },
                    "dateOfBirth": "19990131",
                    "identification": {
                      "type": "SSN",
                      "number": "243353678"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "address": {
        "type": "object",
        "description": "Address",
        "required": [
          "line1",
          "city",
          "state",
          "zipcode"
        ],
        "properties": {
          "line1": {
            "$ref": "#/components/schemas/line1"
          },
          "line2": {
            "$ref": "#/components/schemas/line2"
          },
          "city": {
            "$ref": "#/components/schemas/city"
          },
          "state": {
            "$ref": "#/components/schemas/state"
          },
          "zipcode": {
            "$ref": "#/components/schemas/zipcode"
          },
          "country": {
            "$ref": "#/components/schemas/country"
          }
        }
      },
      "businessOwner": {
        "type": "object",
        "description": "Additional individuals that own at least 25% of the entity.",
        "required": [
          "name",
          "dateOfBirth"
        ],
        "properties": {
          "name": {
            "$ref": "#/components/schemas/namefml"
          },
          "dateOfBirth": {
            "type": "string",
            "description": "Date of birth with the format: YYYYMMDD. Owner must be at least 18 years old."
          }
        }
      },
      "city": {
        "type": "string",
        "description": "City",
        "pattern": "^[ a-zA-Z0-9_-]+$"
      },
      "companyType": {
        "type": "string",
        "description": "Legal structure of the business or individual",
        "enum": [
          "LLC",
          "LLP",
          "C-Corp",
          "S-Corp",
          "SoleProprietor",
          "Nonprofit",
          "Charitable",
          "NaturalPerson",
          "Other"
        ]
      },
      "country": {
        "type": "string",
        "description": "[Country Code](https://developers.tabapay.com/reference/country-codes#/)\n\n*Optional. Default is `840`*",
        "pattern": "^[0-9]{3}$",
        "example": "840"
      },
      "line1": {
        "type": "string",
        "description": "Address Line 1",
        "pattern": "^[ a-zA-Z0-9._-]+$"
      },
      "line2": {
        "type": "string",
        "description": "Address Line 2\n\n*Optional*",
        "pattern": "^[ a-zA-Z0-9._-]+$"
      },
      "namefml": {
        "type": "object",
        "description": "Name including `first`, `middle`, `last`.\n\n`first` and `last` are required, and `middle` is optional*",
        "required": [
          "first"
        ],
        "properties": {
          "first": {
            "type": "string",
            "description": "First Name",
            "pattern": "^[ a-zA-Z0-9_-]+$"
          },
          "middle": {
            "type": "string",
            "description": "Middle Name",
            "pattern": "^[ a-zA-Z0-9_-]+$"
          },
          "last": {
            "type": "string",
            "description": "Last Name",
            "pattern": "^[ a-zA-Z0-9_-]+$"
          }
        }
      },
      "phone": {
        "type": "object",
        "required": [
          "number"
        ],
        "description": "Phone *object*",
        "properties": {
          "countryCode": {
            "type": "string",
            "description": "1-3 digit Country Calling Code\n\n*Optional.* Default is `1`.",
            "pattern": "^[0-9]{3}$",
            "example": "1"
          },
          "number": {
            "type": "string",
            "description": "Phone Number.\n\nFor phone numbers with `countryCode` equal to `1` (or blank), provide a 10-digit phone number. For all `countryCodes`, other than `1`, a 4-14 digit phone number is accepted.",
            "pattern": "^[0-9]{4,14}$",
            "example": "5555555555"
          }
        }
      },
      "state": {
        "type": "string",
        "description": "State Code\n\n[State Code](https://developers.tabapay.com/reference/us-state-codes#/) must be a valid 2-character code if `country` is [840](https://developers.tabapay.com/reference/country-codes#/) or [Canadian 2-char code](https://developers.tabapay.com/reference/canadian-province-codes#/) if [124](https://developers.tabapay.com/reference/country-codes#/).",
        "pattern": "^[ a-zA-Z0-9_-]+$"
      },
      "tpDateYYYYMMDD": {
        "type": "string",
        "description": "Date in YYYYMMDD format",
        "pattern": "^[0-9]{8}$",
        "example": "19990131"
      },
      "tpReferenceID": {
        "type": "string",
        "description": "Client-defined reference identifier",
        "minLength": 1,
        "maxLength": 15,
        "pattern": "^[A-Za-z0-9._-]+$"
      },
      "userCreate": {
        "type": "object",
        "required": [
          "referenceID",
          "type",
          "name",
          "email",
          "authorizedSigners"
        ],
        "properties": {
          "referenceID": {
            "$ref": "#/components/schemas/tpReferenceID"
          },
          "type": {
            "$ref": "#/components/schemas/companyType"
          },
          "name": {
            "$ref": "#/components/schemas/userName"
          },
          "email": {
            "type": "string",
            "format": "email",
            "description": "Valid Email Address"
          },
          "phone": {
            "$ref": "#/components/schemas/phone"
          },
          "address": {
            "$ref": "#/components/schemas/address"
          },
          "dateOfBirth": {
            "$ref": "#/components/schemas/tpDateYYYYMMDD"
          },
          "dateOfFormation": {
            "$ref": "#/components/schemas/tpDateYYYYMMDD"
          },
          "identification": {
            "$ref": "#/components/schemas/userIdentification"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "description": "Company or personal website.",
            "example": "https://example.com"
          },
          "stateOfFormation": {
            "type": "string",
            "description": "State or jurisdiction where the company was formed. Use 2-letter [State Code](https://developers.tabapay.com/reference/us-state-codes#/)\n\n For company types only",
            "example": "DE"
          },
          "registrationType": {
            "type": "string",
            "description": "Company registration type. Only applicable to company types."
          },
          "authorizedSigners": {
            "type": "object",
            "description": "Individuals authorized to act on behalf of the company. Required for company types.",
            "required": [
              "authorizedSigner1"
            ],
            "properties": {
              "authorizedSigner1": {
                "$ref": "#/components/schemas/userPerson"
              },
              "authorizedSigner2": {
                "$ref": "#/components/schemas/userPerson"
              },
              "authorizedSigner3": {
                "$ref": "#/components/schemas/userPerson"
              },
              "authorizedSigner4": {
                "$ref": "#/components/schemas/userPerson"
              }
            }
          },
          "controlPerson": {
            "$ref": "#/components/schemas/userPerson"
          },
          "businessOwners": {
            "type": "object",
            "description": "Individuals that own at least 25% of the entity, or the largest owner if no one owns at least 25%.\n**Note: If you plan to add/remove/modify any owner information in the future, you will need re-submit all existing information to the update SubClient API. It is recommend that you store the owner information for this purpose.**",
            "properties": {
              "businessOwner1": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/businessOwner"
                  },
                  {
                    "properties": {
                      "identification": {
                        "$ref": "#/components/schemas/userIdentification"
                      }
                    }
                  }
                ]
              },
              "businessOwner2": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/businessOwner"
                  },
                  {
                    "properties": {
                      "identification": {
                        "$ref": "#/components/schemas/userIdentification"
                      }
                    }
                  }
                ]
              },
              "businessOwner3": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/businessOwner"
                  },
                  {
                    "properties": {
                      "identification": {
                        "$ref": "#/components/schemas/userIdentification"
                      }
                    }
                  }
                ]
              },
              "businessOwner4": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/businessOwner"
                  },
                  {
                    "properties": {
                      "identification": {
                        "$ref": "#/components/schemas/userIdentification"
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      },
      "userIdentification": {
        "type": "object",
        "required": [
          "type",
          "number"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "SSN",
              "GovernmentID",
              "Passport",
              "EIN"
            ]
          },
          "number": {
            "type": "string",
            "description": "A unique ID number issued by a government or organization."
          }
        }
      },
      "userName": {
        "type": "object",
        "properties": {
          "individual": {
            "$ref": "#/components/schemas/userNameIndividual"
          },
          "company": {
            "$ref": "#/components/schemas/userNameCompany"
          }
        },
        "description": "For type NaturalPerson use name.individual; otherwise use name.company."
      },
      "userNameCompany": {
        "type": "object",
        "required": [
          "legal"
        ],
        "properties": {
          "legal": {
            "type": "string",
            "description": "Legal name"
          },
          "dba": {
            "type": "string",
            "description": "Doing Business As (DBA)"
          }
        }
      },
      "userNameIndividual": {
        "type": "object",
        "required": [
          "first",
          "last"
        ],
        "properties": {
          "first": {
            "type": "string",
            "description": "First name"
          },
          "middle": {
            "type": "string",
            "description": "Middle name"
          },
          "last": {
            "type": "string",
            "description": "Last name"
          },
          "suffix": {
            "type": "string",
            "maxLength": 50
          }
        }
      },
      "userPerson": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "$ref": "#/components/schemas/namefml"
          },
          "dateOfBirth": {
            "$ref": "#/components/schemas/tpDateYYYYMMDD"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "phone": {
            "$ref": "#/components/schemas/phone"
          },
          "address": {
            "$ref": "#/components/schemas/address"
          },
          "identification": {
            "$ref": "#/components/schemas/userPersonIdentification"
          }
        }
      },
      "userPersonIdentification": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "SSN",
              "SSN4",
              "NationalID",
              "Passport",
              "GovernmentID"
            ]
          },
          "number": {
            "type": "string",
            "description": "Identification number."
          },
          "country": {
            "type": "string",
            "description": "3-digit country code."
          }
        }
      },
      "zipcode": {
        "type": "string",
        "description": "Zip Code\n\nIf `country` is `840`, `zipcode` must be 5 or 9 digits.\nIf country is `124`, `zipcode` must be in the *A1A 1A1* format.\nZip codes from other countries will not be checked.",
        "pattern": "^[ a-zA-Z0-9_-]+$"
      }
    }
  }
}