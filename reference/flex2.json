{
  "openapi": "3.1.0",
  "info": {
    "title": "FLEX  NEW-TEST_new",
    "description": "The NEW 2 Flex Ingestion API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://some.cpd"
    }
  ],
  "paths": {
    "/ingest/v0/customers/events/2": {
      "post": {
        "operationId": "flex",
        "summary": "Customer events",
        "description": "Ingests events related to customer activity.",
        "requestBody": {
          "description": "An array of customer records to synchronise",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CustomerEvents"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful operation"
          },
          "400": {
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/user": {
      "get": {
        "responses": {
          "200": {
            "description": ""
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CustomerEventBase": {
        "type": "object",
        "required": [
          "type_id"
        ],
        "properties": {
          "country": {
            "type": "string",
            "pattern": "ISO 3166-1 alpha-2 code",
            "description": "country code",
            "examples": [
              "ZA"
            ]
          },
          "type_id": {
            "type": "integer",
            "description": "Event type",
            "enum": [
              1,
              2,
              20,
              50
            ]
          }
        }
      },
      "OptOutEvent": {
        "allOf": [
          {
            "$ref": "#/components/schemas/CustomerEventBase"
          },
          {
            "type": "object",
            "required": [
              "type_id"
            ],
            "properties": {
              "type_id": {
                "type": "integer",
                "enum": [
                  1
                ]
              },
              "name": {
                "type": "string",
                "description": "OptOutEvent"
              }
            }
          }
        ]
      },
      "OptInEvent": {
        "allOf": [
          {
            "$ref": "#/components/schemas/CustomerEventBase"
          },
          {
            "type": "object",
            "required": [
              "type_id"
            ],
            "properties": {
              "type_id": {
                "type": "integer",
                "enum": [
                  2
                ]
              },
              "name": {
                "type": "string",
                "description": "OptInEvent"
              }
            }
          }
        ]
      },
      "InboundMessageEvent": {
        "allOf": [
          {
            "$ref": "#/components/schemas/CustomerEventBase"
          },
          {
            "type": "object",
            "properties": {
              "type_id": {
                "type": "integer",
                "enum": [
                  20
                ]
              },
              "channel": {
                "type": "integer",
                "enum": [
                  1,
                  2,
                  3
                ],
                "description": "1 - WhatsApp, 2 - SMS, 3 - Email"
              }
            }
          }
        ]
      },
      "TagEvent": {
        "allOf": [
          {
            "$ref": "#/components/schemas/CustomerEventBase"
          },
          {
            "type": "object",
            "properties": {
              "type_id": {
                "type": "integer",
                "enum": [
                  50
                ]
              },
              "name": {
                "type": "string",
                "description": "TagEvent"
              }
            }
          }
        ]
      },
      "TagEvent2": {
        "allOf": [
          {
            "$ref": "#/components/schemas/CustomerEventBase"
          },
          {
            "type": "object",
            "properties": {
              "type_id": {
                "type": "integer",
                "enum": [
                  51
                ]
              },
              "name": {
                "type": "string",
                "description": "TagEvent2"
              }
            }
          }
        ]
      },
      "TagEvent3": {
        "allOf": [
          {
            "$ref": "#/components/schemas/CustomerEventBase"
          },
          {
            "type": "object",
            "properties": {
              "type_id": {
                "type": "integer",
                "enum": [
                  53
                ]
              },
              "name": {
                "type": "string",
                "description": "TagEvent3"
              }
            }
          }
        ]
      },
      "TagEvent4": {
        "allOf": [
          {
            "$ref": "#/components/schemas/CustomerEventBase"
          },
          {
            "type": "object",
            "properties": {
              "type_id": {
                "type": "integer",
                "enum": [
                  54
                ]
              },
              "name": {
                "type": "string",
                "description": "TagEvent4"
              }
            }
          }
        ]
      },
      "TagEvent5": {
        "allOf": [
          {
            "$ref": "#/components/schemas/CustomerEventBase"
          },
          {
            "type": "object",
            "properties": {
              "type_id": {
                "type": "integer",
                "enum": [
                  55
                ]
              },
              "name": {
                "type": "string",
                "description": "TagEvent5"
              }
            }
          }
        ]
      },
      "CustomerEvents": {
        "type": "array",
        "items": {
          "anyOf": [
            {
              "title": "Opt out event",
              "$ref": "#/components/schemas/OptOutEvent"
            },
            {
              "title": "Opt in event",
              "$ref": "#/components/schemas/OptInEvent"
            },
            {
              "title": "Inbound message event",
              "$ref": "#/components/schemas/InboundMessageEvent"
            },
            {
              "title": "Tag event for adding or removing tags",
              "$ref": "#/components/schemas/TagEvent"
            },
            {
              "title": "2-Tag event for adding or removing tags",
              "$ref": "#/components/schemas/TagEvent2"
            },
            {
              "title": "3-Tag event for adding or removing tags",
              "$ref": "#/components/schemas/TagEvent3"
            }
          ],
          "discriminator": {
            "propertyName": "type_id",
            "mapping": {
              "1": "#/components/schemas/OptOutEvent",
              "2": "#/components/schemas/OptInEvent",
              "20": "#/components/schemas/InboundMessageEvent",
              "50": "#/components/schemas/TagEvent"
            }
          }
        }
      }
    }
  }
}
