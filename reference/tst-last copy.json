    "/v2/internal/audit-trail/outboxes/{outbox}/entries": {
      "post": {
        "description": "Search outbox entries",
        "operationId": "searchOutboxEntries",
        "parameters": [
          {
            "description": "Outbox name",
            "in": "path",
            "name": "outbox",
            "required": true,
            "schema": {
              "maxLength": 255,
              "minLength": 1,
              "pattern": "^\\S(.*\\S)?$",
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/outbox.OutboxQueryParams.from"
          },
          {
            "$ref": "#/components/parameters/outbox.OutboxQueryParams.to"
          },
          {
            "$ref": "#/components/parameters/outbox.OutboxQueryParams.createdFrom"
          },
          {
            "$ref": "#/components/parameters/outbox.OutboxQueryParams.createdTo"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "unevaluatedProperties": {}
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/outbox.entry.PagedResponse"
                }
              }
            },
            "description": "The request has succeeded."
          }
        },
        "security": [
          {
            "oauth2": [
              "internal"
            ]
          }
        ],
        "summary": "Search outbox entries",
        "tags": [
          "Outbox Internal",
          "private"
        ]
      }
    },
