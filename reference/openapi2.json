{
  "openapi": "3.1.0",
  "info": {
    "title": "Mini Mart Cart & Chat API",
    "version": "1.0.0",
    "description": "API definition for Mini Mart's AI-powered chat assistant and cart order system.\nBuilt on Anthropic's Claude API — hosted at 347 13th Street, Oakland CA 94601.\nContact Eamon at (510) 455-1891 for store inquiries.\n",
    "contact": {
      "name": "Eamon — Mini Mart",
      "x-phone": "+15104551891"
    },
    "license": {
      "name": "Private"
    }
  },
  "servers": [
    {
      "url": "https://api.anthropic.com",
      "description": "Anthropic Production API"
    }
  ],
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "paths": {
    "/v1/messages": {
      "post": {
        "operationId": "sendChatMessage",
        "summary": "Send a chat message to the Mini Mart Assistant",
        "description": "Sends a user message to Claude and returns an AI-generated response.\nUsed by the Mini Mart website chat widget to answer questions about\nproducts, hours, orders, and store info.\n",
        "tags": [
          "Chat Assistant"
        ],
        "parameters": [
          {
            "in": "header",
            "name": "anthropic-version",
            "required": true,
            "schema": {
              "type": "string",
              "default": "2023-06-01"
            },
            "description": "Anthropic API version"
          },
          {
            "in": "header",
            "name": "anthropic-dangerous-direct-browser-access",
            "required": true,
            "schema": {
              "type": "string",
              "default": "true"
            },
            "description": "Required for browser-based direct API access"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              },
              "examples": {
                "askAboutHours": {
                  "summary": "Ask store hours",
                  "value": {
                    "model": "claude-sonnet-4-20250514",
                    "max_tokens": 800,
                    "system": "You are the warm assistant for Mini Mart at 347 13th St Oakland CA. Hours: Mon-Fri 7AM-12AM, Sat-Sun 7AM-11PM. Contact Eamon at (510) 455-1891.\n",
                    "messages": [
                      {
                        "role": "user",
                        "content": "What are your hours today?"
                      }
                    ]
                  }
                },
                "askAboutSnacks": {
                  "summary": "Ask about snack products",
                  "value": {
                    "model": "claude-sonnet-4-20250514",
                    "max_tokens": 800,
                    "system": "You are the warm assistant for Mini Mart at 347 13th St Oakland CA. Snacks available: Takis Fuego, Whole Shabang, Herr's Carolina Reaper, Cheetos Puffs, Doritos Spicy Sweet Chili, Haribo, Sour Strips, and more.\n",
                    "messages": [
                      {
                        "role": "user",
                        "content": "What hot chips do you carry?"
                      }
                    ]
                  }
                },
                "placeOrder": {
                  "summary": "Customer places a cart order via chat",
                  "value": {
                    "model": "claude-sonnet-4-20250514",
                    "max_tokens": 800,
                    "system": "You are the order assistant for Mini Mart. Help the customer summarize their cart and direct them to call or text Eamon at (510) 455-1891 to confirm. Always be warm and helpful.\n",
                    "messages": [
                      {
                        "role": "user",
                        "content": "I want to order: 2x Celsius, 1x Takis Fuego, 1x Saratoga Water"
                      }
                    ]
                  }
                },
                "multiTurn": {
                  "summary": "Multi-turn conversation with history",
                  "value": {
                    "model": "claude-sonnet-4-20250514",
                    "max_tokens": 800,
                    "system": "You are the Mini Mart assistant.",
                    "messages": [
                      {
                        "role": "user",
                        "content": "Do you have energy drinks?"
                      },
                      {
                        "role": "assistant",
                        "content": "Yes! We carry Celsius, Monster, C4, Rockstar, and more."
                      },
                      {
                        "role": "user",
                        "content": "How much is Celsius?"
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful AI response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatResponse"
                },
                "example": {
                  "id": "msg_01XFDUDYJgAACzvnptvVoYEL",
                  "type": "message",
                  "role": "assistant",
                  "content": [
                    {
                      "type": "text",
                      "text": "Ahlan wa sahlan (Welcome)! 🌟 We're open Monday through Friday from 7 AM to 12 AM midnight, and Saturday–Sunday from 7 AM to 11 PM. Is there anything else I can help you with?\n"
                    }
                  ],
                  "model": "claude-sonnet-4-20250514",
                  "stop_reason": "end_turn",
                  "usage": {
                    "input_tokens": 120,
                    "output_tokens": 48
                  }
                }
              }
            }
          },
          "401": {
            "description": "Invalid or missing API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "type": "error",
                  "error": {
                    "type": "authentication_error",
                    "message": "invalid x-api-key"
                  }
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key",
        "description": "Your Anthropic API key (starts with sk-ant-)"
      }
    },
    "schemas": {
      "ChatRequest": {
        "type": "object",
        "required": [
          "model",
          "max_tokens",
          "messages"
        ],
        "properties": {
          "model": {
            "type": "string",
            "enum": [
              "claude-sonnet-4-20250514",
              "claude-haiku-4-5-20251001",
              "claude-opus-4-20250514"
            ],
            "default": "claude-sonnet-4-20250514",
            "description": "Claude model to use. Sonnet recommended for Mini Mart chat."
          },
          "max_tokens": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4096,
            "default": 800,
            "description": "Maximum tokens in the response. 800 is ideal for chat replies."
          },
          "system": {
            "type": "string",
            "description": "System prompt that defines the assistant's persona, store info, product catalog, and behavior. Set once per session.\n",
            "example": "You are the warm, knowledgeable assistant for Mini Mart — a Bay Area convenience store with Yemeni roots at 347 13th Street Oakland CA 94601. Hours: Mon-Fri 7AM-12AM, Sat-Sun 7AM-11PM. Contact Eamon at (510) 455-1891.\n"
          },
          "messages": {
            "type": "array",
            "description": "Conversation history. Include all prior turns for multi-turn chat.",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/Message"
            }
          }
        }
      },
      "Message": {
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant"
            ],
            "description": "Who sent this message."
          },
          "content": {
            "type": "string",
            "description": "The message text content."
          }
        }
      },
      "ChatResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique message ID"
          },
          "type": {
            "type": "string",
            "example": "message"
          },
          "role": {
            "type": "string",
            "example": "assistant"
          },
          "content": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "example": "text"
                },
                "text": {
                  "type": "string",
                  "description": "The assistant's reply text"
                }
              }
            }
          },
          "model": {
            "type": "string",
            "description": "Model used to generate the response"
          },
          "stop_reason": {
            "type": "string",
            "enum": [
              "end_turn",
              "max_tokens",
              "stop_sequence"
            ]
          },
          "usage": {
            "type": "object",
            "properties": {
              "input_tokens": {
                "type": "integer"
              },
              "output_tokens": {
                "type": "integer"
              }
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "example": "error"
          },
          "error": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "authentication_error",
                  "rate_limit_error",
                  "invalid_request_error",
                  "api_error"
                ]
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Chat Assistant",
      "description": "Powers the Mini Mart AI chat widget. Answers questions about products, store hours, orders, and directs customers to contact Eamon at (510) 455-1891.\n"
    }
  ]
}